# Puerto del servidor HTTP
PORT=4000

# Origen permitido para CORS (URL del frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Ruta del archivo SQLite (relativa a backend/)
DATABASE_PATH=./data/app.sqlite

# Secreto para firmar los JWT de sesion. Cambialo en produccion.
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# "production" habilita cookies Secure (requiere HTTPS)
NODE_ENV=development
