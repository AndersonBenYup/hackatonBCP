# Puerto del servidor HTTP
PORT=4000

# Origen permitido para CORS (URL del frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Credenciales de Firestore.
# Local: deja esta variable vacia y en su lugar define GOOGLE_APPLICATION_CREDENTIALS
# apuntando al service account que descargaste de Firebase (ej. ./firebase.json,
# gitignored, nunca lo subas). Ejemplo para tu .env local:
#   GOOGLE_APPLICATION_CREDENTIALS=./firebase.json
# Produccion (Render): pega aqui el JSON completo del service account como un solo
# string (sin saltos de linea reales, usa \n dentro del private_key igual que el JSON original).
FIREBASE_SERVICE_ACCOUNT=

# Secreto para firmar los JWT de sesion. Cambialo en produccion.
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# "production" habilita cookies Secure (requiere HTTPS)
NODE_ENV=development

# API key de OpenRouter (solo backend, nunca se expone al frontend).
# Opcional: sin ella la API arranca igual y el asistente responde 503.
OPENROUTER_API_KEY=

# Clave de admin@finza.app (minimo 8 caracteres). Si la defines, la cuenta se crea
# o su clave se reemplaza por esta al reiniciar. Vacia, no se crea ni se modifica.
ADMIN_PASSWORD=

# Clave de demo@finza.app. Vacia, se usa demo123. La cuenta se crea sola al arrancar.
DEMO_PASSWORD=
